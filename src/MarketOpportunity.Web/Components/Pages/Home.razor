@page "/"
@implements IAsyncDisposable
@inject ScannerState Scanner
@inject ScannerConfiguration Configuration
@inject IJSRuntime JS

<PageTitle>Market Opportunity Engine</PageTitle>

<section class="dashboard">
    <header class="dashboard-header">
        <div>
            <p class="eyebrow">MILESTONE A · @_status.Source.ToUpperInvariant()</p>
            <h1>Market Opportunity Scanner</h1>
            <p class="lede">Deterministic setup analysis from replayable market events.</p>
        </div>
        <div class="feed-state @FeedClass">
            <span class="status-dot"></span>
            <div>
                <strong>@_status.FeedStatus</strong>
                <small>Provider: @_status.Source · Feed: @(_status.Capabilities?.Feed ?? "Unknown")</small>
                <small>Coverage: @(_status.Capabilities?.Coverage ?? MarketDataCoverage.ProviderDefined) (feed capability)</small>
                @if (_status.HasUnresolvedDataGap)
                {
                    <small class="stale-text">Data integrity: unresolved disconnect gap; no backfill performed.</small>
                }
                @if (_status.FeedStatus != MarketDataHealthStatus.Recorded)
                {
                    <small>Last market event: <time class="local-time" data-local-time datetime="@ToUtcIso(_status.LatestEventTimeUtc)">@FormatUtc(_status.LatestEventTimeUtc)</time> · received: <time class="local-time" data-local-time datetime="@ToUtcIso(_status.LatestReceivedTimeUtc)">@FormatUtc(_status.LatestReceivedTimeUtc)</time> · age: @FormatAge(_status.ReceiveAge)</small>
                }
                @if (!string.IsNullOrWhiteSpace(_status.Message))
                {
                    <small>@_status.Message</small>
                }
            </div>
        </div>
    </header>

    @if (_results.Count == 0)
    {
        <div class="empty-state" role="status">
            <h2>@(_status.Source != "Fixture" ? "Waiting for live market data" : "Waiting for fixture analysis")</h2>
            <p>@(_status.Message ?? (_status.Source == "Fixture"
                ? "The recorded events are being processed and persisted."
                : "No live analysis is available yet. Waiting for valid market events; connection health is shown above."))</p>
        </div>
    }
    else
    {
        <section class="summary-grid" aria-label="Market data status">
            <article class="metric-card">
                <span>ANALYSES</span>
                <strong>@_results.Count symbol/session results</strong>
                <small>@_status.EventsProcessed unique canonical events</small>
            </article>
            <article class="metric-card">
                <span>SYMBOLS</span>
                <strong>@_results.Select(result => result.Opportunity.Symbol).Distinct(StringComparer.Ordinal).Count()</strong>
                <small>Each symbol is isolated by explicit session ID</small>
            </article>
            <article class="metric-card">
                <span>SESSIONS</span>
                <strong>@_results.Select(result => result.Opportunity.SessionId).Distinct(StringComparer.Ordinal).Count()</strong>
                <small>Session values are fixture identifiers, not calendar inference</small>
            </article>
            <article class="metric-card">
                <span>LATEST EVENT TIME · LOCAL</span>
                <strong><time class="local-time" data-local-time datetime="@ToUtcIso(_status.LatestEventTimeUtc)">@FormatUtc(_status.LatestEventTimeUtc)</time></strong>
                <small>Displayed in your browser's local time zone · analytical time remains event time</small>
            </article>
        </section>

        <section class="opportunity-list" aria-label="Symbol and session analyses">
            @foreach (var result in _results.OrderBy(item => item.Opportunity.SessionId, StringComparer.Ordinal)
                .ThenBy(item => item.Opportunity.Symbol, StringComparer.Ordinal))
            {
                var opportunity = result.Opportunity;
                var features = result.Features;
                <article class="opportunity-card" @key="opportunity.Id">
                    <header class="opportunity-heading">
                        <div>
                            <p class="eyebrow">SETUP · @opportunity.SetupType</p>
                            <h2>
                                @opportunity.Symbol
                                <span class="classification @ClassificationClass(opportunity.Classification)">
                                    @ClassificationLabel(opportunity.Classification)
                                </span>
                            </h2>
                            <p class="publication-state @PublicationClass(result.Publication.State)">
                                @result.Publication.State · @result.Publication.Reason
                            </p>
                            <p class="bias-line">
                                Session: @opportunity.SessionId · Bias: @opportunity.Bias ·
                                VWAP: @FormatPrice(features.SessionVwap) ·
                                Spread: @FormatSpread(features.SpreadBasisPoints)
                            </p>
                        </div>
                        <div class="as-of">
                            <span>AS OF</span>
                            <strong><time class="local-time" data-local-time datetime="@ToUtcIso(opportunity.AsOfUtc)">@FormatUtc(opportunity.AsOfUtc)</time></strong>
                            <small>Expires <time class="local-time" data-local-time datetime="@ToUtcIso(opportunity.ValidUntilUtc)">@FormatUtc(opportunity.ValidUntilUtc)</time></small>
                        </div>
                    </header>

                    <section class="summary-grid" aria-label="Analysis details">
                        <article class="metric-card">
                            <span>REFERENCE PRICE</span>
                            <strong>@FormatPrice(features.ReferencePrice)</strong>
                            <small>Rules-based setup quality: @opportunity.QualityScore / 100</small>
                        </article>
                        <article class="metric-card">
                            <span>FRESHNESS</span>
                            <strong class="@FreshnessClass(features)">@FreshnessLabel(features)</strong>
                            <small>Quote age: @FormatAge(features.QuoteAge) · data quality: @features.DataQuality</small>
                        </article>
                        <article class="metric-card">
                            <span>FEATURE SNAPSHOT</span>
                            <strong>@features.Id.ToString("N")[..12]</strong>
                            <small>@opportunity.FeatureSetVersion</small>
                        </article>
                    </section>

                    <section class="summary-grid" aria-label="Existing momentum and volume fields">
                        <article class="metric-card">
                            <span>MOMENTUM</span>
                            <strong>@FormatPercent(features.ShortHorizonReturnPercent)</strong>
                            <small>Secondary horizon: @FormatPercent(features.SecondaryHorizonReturnPercent)</small>
                        </article>
                        <article class="metric-card">
                            <span>VOLUME</span>
                            <strong>@FormatVolume(features.ShortHorizonVolume)</strong>
                            <small>Window dollar volume: @FormatDollars(features.ShortHorizonDollarVolumeUsd) · @features.ShortHorizonDollarVolumeStatus</small>
                            <small>Session cumulative: @FormatVolume(features.SessionCumulativeVolume)</small>
                        </article>
                        <article class="metric-card">
                            <span>TREND</span>
                            <strong>@features.SessionTrendDirection</strong>
                            <small>VWAP slope: @features.SessionVwapSlopeDirection · EMA fast/medium: @FormatPrice(features.FastEma) / @FormatPrice(features.MediumEma)</small>
                            <small>Price structure: @(features.SessionPriceStructure?.ToString() ?? "Insufficient") · ADX: @FormatPrice(features.SessionAdx) (@features.SessionAdxStatus)</small>
                        </article>
                        <article class="metric-card structure-observations" aria-label="Market Structure">
                            <span>MARKET STRUCTURE</span>
                            <strong>@features.StructureState</strong>
                            <small>Current price: @FormatStructurePrice(features.ReferencePrice) · availability: @features.MarketStructureStatus @(features.HasCompleteSessionData ? "" : "(partial retained state)")</small>
                            <small>Latest swing high: @FormatStructurePrice(features.LatestConfirmedSwingHigh?.Price) · previous: @FormatStructurePrice(features.PreviousConfirmedSwingHigh?.Price) · @features.HighSwingRelationship</small>
                            <small>Latest swing low: @FormatStructurePrice(features.LatestConfirmedSwingLow?.Price) · previous: @FormatStructurePrice(features.PreviousConfirmedSwingLow?.Price) · @features.LowSwingRelationship</small>
                            <small>Nearest resistance candidate: @FormatStructurePrice(features.NearestResistanceCandidate?.Price) · support candidate: @FormatStructurePrice(features.NearestSupportCandidate?.Price)</small>
                            <small>Distance to nearest confirmed high/low: @FormatStructurePrice(features.DistanceToNearestConfirmedSwingHigh) / @FormatStructurePrice(features.DistanceToNearestConfirmedSwingLow) (@FormatPercent(features.DistanceToNearestConfirmedSwingHighPercent) / @FormatPercent(features.DistanceToNearestConfirmedSwingLowPercent))</small>
                        </article>
                        <article class="metric-card">
                            <span>QUALITY / RANGE</span>
                            <strong>@opportunity.QualityScore / 100</strong>
                            <small>Range position: @FormatPercent(features.SessionRangePositionPercent) · realized volatility: @FormatPercent(features.SessionRealizedVolatilityPercent)</small>
                            <small>Data quality: @features.DataQuality · complete session: @features.HasCompleteSessionData</small>
                        </article>
                    </section>

                    <section class="invalidation-panel trade-plan-panel" aria-label="Trade plan">
                        <h3>TRADE PLAN</h3>
                        <p>
                            <strong>@PlanTitle(result.TradePlan) · @result.TradePlan.Status</strong>
                            · current publication: @result.Publication.State
                        </p>
                        <p>
                            Entry zone: @FormatZone(result.TradePlan.EntryZone) ·
                            entry reference: @FormatStructurePrice(result.TradePlan.EntryReferencePrice)
                        </p>
                        <p>
                            Invalidation: @FormatStructurePrice(result.TradePlan.InvalidationPrice) ·
                            Target 1: @FormatStructurePrice(result.TradePlan.Target1?.Price) ·
                            Target 2: @FormatStructurePrice(result.TradePlan.Target2?.Price)
                        </p>
                        <p>
                            Risk/share: @FormatStructurePrice(result.TradePlan.RiskPerShare) ·
                            Reward/share: @FormatStructurePrice(result.TradePlan.RewardPerShareToTarget1) ·
                            Reward / Risk: @FormatRewardRisk(result.TradePlan.RewardRiskRatioTarget1)
                        </p>
                        <p>
                            As of @FormatUtc(result.TradePlan.AsOfUtc) ·
                            expires @FormatUtc(result.TradePlan.ValidUntilUtc) ·
                            version @result.TradePlan.PlanDefinitionVersion
                        </p>
                        @if (result.TradePlan.Evidence.Count > 0)
                        {
                            <h4>Structural reasoning</h4>
                            <ul class="evidence-list">
                                @foreach (var evidence in result.TradePlan.Evidence)
                                {
                                    <li><strong>@evidence.Code</strong><span>@evidence.Description</span></li>
                                }
                            </ul>
                        }
                        <p class="muted">Candidate geometry only; it is not an instruction to trade.</p>
                    </section>

                    <div class="evidence-grid">
                        <section>
                            <h3>Supporting evidence</h3>
                            @if (opportunity.SupportingEvidence.Count == 0)
                            {
                                <p class="muted">No supporting evidence qualified.</p>
                            }
                            else
                            {
                                <ul class="evidence-list positive">
                                    @foreach (var evidence in opportunity.SupportingEvidence)
                                    {
                                        <li><strong>@evidence.Code</strong><span>@evidence.Description</span></li>
                                    }
                                </ul>
                            }
                        </section>
                        <section>
                            <h3>Contradictory evidence</h3>
                            @if (opportunity.ContradictoryEvidence.Count == 0)
                            {
                                <p class="muted">No contradictions recorded.</p>
                            }
                            else
                            {
                                <ul class="evidence-list contradictory">
                                    @foreach (var evidence in opportunity.ContradictoryEvidence)
                                    {
                                        <li><strong>@evidence.Code</strong><span>@evidence.Description</span></li>
                                    }
                                </ul>
                            }
                        </section>
                    </div>

                    <section class="invalidation-panel">
                        <h3>Invalidation condition</h3>
                        <p>@opportunity.InvalidationCondition</p>
                    </section>

                    <section class="veto-panel" aria-label="Active vetoes">
                        <h3>Vetoes · @(opportunity.ActiveVetoes.Count == 0 ? "none" : "trade rejected")</h3>
                        @if (opportunity.ActiveVetoes.Count == 0)
                        {
                            <p>No active vetoes.</p>
                        }
                        else
                        {
                            <ul>
                                @foreach (var veto in opportunity.ActiveVetoes)
                                {
                                    <li>@veto</li>
                                }
                            </ul>
                        }
                    </section>

                    <footer class="version-row">
                        <span>Market data: @opportunity.MarketData.Provider / @opportunity.MarketData.Feed (@opportunity.MarketData.Coverage)</span>
                        <span>Opportunity: @opportunity.Id.ToString("N")[..12]</span>
                        <span>Feature set: @opportunity.FeatureSetVersion</span>
                        <span>Setup: @opportunity.SetupDefinitionVersion</span>
                        <span>Configuration: @opportunity.ConfigurationVersion</span>
                    </footer>
                </article>
            }
        </section>
    }

    <p class="disclaimer">Read-only market-data analysis. A setup quality score is not a probability of profit or a trading recommendation.</p>
</section>

@code {
    private ScannerStatus _status = new(
        MarketDataHealthStatus.Connecting,
        "Unknown",
        0,
        null,
        null,
        Capabilities: MarketDataCapabilities.Unknown);
    private IReadOnlyList<ScannerAnalysisResult> _results = [];
    private IJSObjectReference? _localTimeModule;

    private string FeedClass => _status.FeedStatus switch
    {
        MarketDataHealthStatus.Recorded => "feed-recorded",
        MarketDataHealthStatus.Live => "feed-live",
        MarketDataHealthStatus.Stale or MarketDataHealthStatus.Offline => "feed-stale",
        MarketDataHealthStatus.Error => "feed-error",
        _ => "feed-pending"
    };

    private static string PublicationClass(OpportunityLifecycleState state) => state switch
    {
        OpportunityLifecycleState.Active => "publication-active",
        OpportunityLifecycleState.Expired or OpportunityLifecycleState.Invalidated
            or OpportunityLifecycleState.NotQualified => "publication-inactive",
        _ => "publication-suspended"
    };

    protected override void OnInitialized()
    {
        Scanner.Changed += HandleChanged;
        ReadState();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _localTimeModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/local-time.js");
        }

        if (_localTimeModule is not null)
        {
            await _localTimeModule.InvokeVoidAsync("formatLocalTimes");
        }
    }

    private void HandleChanged()
    {
        _ = InvokeAsync(() =>
        {
            ReadState();
            StateHasChanged();
        });
    }

    private void ReadState()
    {
        var result = Scanner.Read();
        _status = result.Status;
        _results = result.Results;
    }

    private string FreshnessClass(FeatureSnapshot features) =>
        features.DataQuality != DataQualityStatus.Good
        || !features.IsQuoteValid
        || !features.IsPriceDataValid
        || features.QuoteAge is null
        || features.QuoteAge > TimeSpan.FromSeconds(Configuration.MaximumQuoteAgeSeconds)
            ? "stale-text"
            : "fresh-text";

    private string FreshnessLabel(FeatureSnapshot features) =>
        features.QuoteAge is null
        || features.QuoteAge > TimeSpan.FromSeconds(Configuration.MaximumQuoteAgeSeconds)
            ? "Stale"
            : features.DataQuality == DataQualityStatus.Good
                && features.IsQuoteValid
                && features.IsPriceDataValid
                ? "Fresh"
                : features.DataQuality.ToString();

    private static string ClassificationLabel(OpportunityClassification classification) => classification switch
    {
        OpportunityClassification.ProbableLong => "PROBABLE LONG",
        OpportunityClassification.ProbableShort => "PROBABLE SHORT",
        OpportunityClassification.Watch => "WATCH",
        _ => "AVOID / NO TRADE"
    };

    private static string ClassificationClass(OpportunityClassification classification) => classification switch
    {
        OpportunityClassification.ProbableLong => "long",
        OpportunityClassification.ProbableShort => "short",
        OpportunityClassification.Watch => "watch",
        _ => "avoid"
    };

    private static string PlanTitle(TradePlan plan) => plan.Direction switch
    {
        TradeDirection.Long => "Potential Long Plan",
        TradeDirection.Short => "Potential Short Plan",
        _ => "No Directional Plan"
    };

    private static string FormatZone(PriceZone? zone) =>
        zone is null
            ? "--"
            : $"{FormatStructurePrice(zone.Low)} - {FormatStructurePrice(zone.High)}";

    private static string FormatRewardRisk(decimal? ratio) =>
        ratio is null ? "--" : $"{ratio.Value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)} : 1";

    private static string FormatPrice(decimal? price) => price?.ToString("F2") ?? "--";
    private static string FormatStructurePrice(decimal? price) =>
        price is null ? "--" : $"${price.Value:F2}";
    private static string FormatSwingPrice(decimal price) =>
        price.ToString("G29", System.Globalization.CultureInfo.InvariantCulture);
    private static string FormatPercent(decimal? value) => value is null ? "--" : $"{value.Value:F2}%";
    private static string FormatVolume(long? volume) => volume?.ToString("N0") ?? "--";
    private static string FormatDollars(decimal? value) => value is null ? "--" : $"${value.Value:N0}";
    private static string FormatSpread(decimal? spread) => spread is null ? "—" : $"{spread:F1} bps";
    private static string FormatAge(TimeSpan? age) => age is null ? "Unavailable" : $"{age.Value.TotalSeconds:F1}s";
    private static string? ToUtcIso(DateTimeOffset? value) =>
        value?.ToUniversalTime().ToString("O", System.Globalization.CultureInfo.InvariantCulture);
    private static string FormatUtc(DateTimeOffset? value) => value is null
        ? "--"
        : FormatUtc(value.Value);
    private static string FormatUtc(DateTimeOffset value, string format = "yyyy-MM-dd HH:mm:ss 'UTC'") =>
        value.UtcDateTime.ToString(format, System.Globalization.CultureInfo.InvariantCulture);

    public async ValueTask DisposeAsync()
    {
        Scanner.Changed -= HandleChanged;

        if (_localTimeModule is not null)
        {
            await _localTimeModule.DisposeAsync();
        }
    }
}
