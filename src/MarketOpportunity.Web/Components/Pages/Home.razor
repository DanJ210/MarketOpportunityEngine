@page "/"
@implements IAsyncDisposable
@inject ScannerState Scanner
@inject ScannerConfiguration Configuration
@inject IJSRuntime JS

<PageTitle>Market Opportunity Engine</PageTitle>

<section class="dashboard">
    <header class="dashboard-header">
        <div>
            <p class="eyebrow">MILESTONE A · @_status.Source.ToUpperInvariant()</p>
            <h1>Market Opportunity Scanner</h1>
            <p class="lede">Deterministic setup analysis from replayable market events.</p>
        </div>
        <div class="feed-state @FeedClass">
            <span class="status-dot"></span>
            <div>
                <strong>@_status.FeedStatus</strong>
                <small>Provider: @_status.Source · Feed: @(_status.Capabilities?.Feed ?? "Unknown")</small>
                <small>Coverage: @(_status.Capabilities?.Coverage ?? MarketDataCoverage.ProviderDefined) (feed capability)</small>
                @if (_status.HasUnresolvedDataGap)
                {
                    <small class="stale-text">Data integrity: unresolved disconnect gap; no backfill performed.</small>
                }
                @if (_status.FeedStatus != MarketDataHealthStatus.Recorded)
                {
                    <small>Last market event: <time class="local-time" data-local-time datetime="@ToUtcIso(_status.LatestEventTimeUtc)">@FormatUtc(_status.LatestEventTimeUtc)</time> · received: <time class="local-time" data-local-time datetime="@ToUtcIso(_status.LatestReceivedTimeUtc)">@FormatUtc(_status.LatestReceivedTimeUtc)</time> · age: @FormatAge(_status.ReceiveAge)</small>
                }
                @if (!string.IsNullOrWhiteSpace(_status.Message))
                {
                    <small>@_status.Message</small>
                }
            </div>
        </div>
    </header>

    @if (_results.Count == 0)
    {
        <section class="symbol-overview" aria-labelledby="symbol-overview-heading">
            <h2 id="symbol-overview-heading">SYMBOL OVERVIEW</h2>
            <p class="symbol-overview-empty" role="status">No symbols are currently available in the scanner.</p>
        </section>
        <div class="empty-state" role="status">
            <h2>@(_status.Source != "Fixture" ? "Waiting for live market data" : "Waiting for fixture analysis")</h2>
            <p>@(_status.Message ?? (_status.Source == "Fixture"
                ? "The recorded events are being processed and persisted."
                : "No live analysis is available yet. Waiting for valid market events; connection health is shown above."))</p>
        </div>
    }
    else
    {
        <section class="summary-grid" aria-label="Market data status">
            <article class="metric-card">
                <span>ANALYSES</span>
                <strong>@_results.Count symbol/session results</strong>
                <small>@_status.EventsProcessed unique canonical events</small>
            </article>
            <article class="metric-card">
                <span>SYMBOLS</span>
                <strong>@_results.Select(result => result.Opportunity.Symbol).Distinct(StringComparer.Ordinal).Count()</strong>
                <small>Each symbol is isolated by explicit session ID</small>
            </article>
            <article class="metric-card">
                <span>SESSIONS</span>
                <strong>@_results.Select(result => result.Opportunity.SessionId).Distinct(StringComparer.Ordinal).Count()</strong>
                <small>Session values are fixture identifiers, not calendar inference</small>
            </article>
            <article class="metric-card">
                <span>LATEST EVENT TIME · LOCAL</span>
                <strong><time class="local-time" data-local-time datetime="@ToUtcIso(_status.LatestEventTimeUtc)">@FormatUtc(_status.LatestEventTimeUtc)</time></strong>
                <small>Displayed in your browser's local time zone · analytical time remains event time</small>
            </article>
        </section>

        <section class="symbol-overview" aria-labelledby="symbol-overview-heading">
            <h2 id="symbol-overview-heading">SYMBOL OVERVIEW</h2>
            <div class="symbol-overview-grid">
                @foreach (var tile in _overview)
                {
                    <a class="symbol-overview-card @tile.StatusClass"
                       href="#@tile.DetailAnchor"
                       aria-label="@OverviewAccessibleLabel(tile)">
                        <strong>@tile.Result.Opportunity.Symbol</strong>
                        <span class="symbol-overview-status">@tile.PrimaryStatus</span>
                        <small class="symbol-overview-session">Session @tile.Result.Opportunity.SessionId</small>
                        @if (tile.SecondaryContext is not null)
                        {
                            <span class="symbol-overview-context">@tile.SecondaryContext</span>
                        }
                    </a>
                }
            </div>
        </section>

        <section class="opportunity-list" aria-label="Symbol and session analyses">
            @foreach (var result in _results.OrderBy(item => item.Opportunity.SessionId, StringComparer.Ordinal)
                .ThenBy(item => item.Opportunity.Symbol, StringComparer.Ordinal))
            {
                var opportunity = result.Opportunity;
                var features = result.Features;
                <article class="opportunity-card" id="@DetailAnchorFor(result)" @key="opportunity.Id">
                    <header class="opportunity-heading">
                        <div>
                            <p class="eyebrow">SETUP · @opportunity.SetupType</p>
                            <h2>
                                @opportunity.Symbol
                                <span class="classification @ClassificationClass(opportunity.Classification)">
                                    @ClassificationLabel(opportunity.Classification)
                                </span>
                            </h2>
                            <p class="publication-state @PublicationClass(result.Publication.State)">
                                @result.Publication.State · @result.Publication.Reason
                            </p>
                            <p class="bias-line">
                                Session: @opportunity.SessionId · Bias: @opportunity.Bias ·
                                VWAP: @FormatPrice(features.SessionVwap) ·
                                Spread: @FormatSpread(features.SpreadBasisPoints)
                            </p>
                        </div>
                        <div class="as-of">
                            <span>AS OF</span>
                            <strong><time class="local-time" data-local-time datetime="@ToUtcIso(opportunity.AsOfUtc)">@FormatUtc(opportunity.AsOfUtc)</time></strong>
                            <small>Expires <time class="local-time" data-local-time datetime="@ToUtcIso(opportunity.ValidUntilUtc)">@FormatUtc(opportunity.ValidUntilUtc)</time></small>
                        </div>
                    </header>

                    <section class="summary-grid" aria-label="Analysis details">
                        <article class="metric-card">
                            <span>REFERENCE PRICE</span>
                            <strong>@FormatPrice(features.ReferencePrice)</strong>
                            <small>Rules-based setup quality: @opportunity.QualityScore / 100</small>
                        </article>
                        <article class="metric-card">
                            <span>FRESHNESS</span>
                            <strong class="@FreshnessClass(features)">@FreshnessLabel(features)</strong>
                            <small>Quote age: @FormatAge(features.QuoteAge) · data quality: @features.DataQuality</small>
                        </article>
                        <article class="metric-card">
                            <span>FEATURE SNAPSHOT</span>
                            <strong>@features.Id.ToString("N")[..12]</strong>
                            <small>@opportunity.FeatureSetVersion</small>
                        </article>
                    </section>

                    <section class="summary-grid" aria-label="Existing momentum and volume fields">
                        <article class="metric-card">
                            <span>MOMENTUM</span>
                            <strong>@FormatPercent(features.ShortHorizonReturnPercent)</strong>
                            <small>Secondary horizon: @FormatPercent(features.SecondaryHorizonReturnPercent)</small>
                        </article>
                        <article class="metric-card">
                            <span>VOLUME</span>
                            <strong>@FormatVolume(features.ShortHorizonVolume)</strong>
                            <small>Window dollar volume: @FormatDollars(features.ShortHorizonDollarVolumeUsd) · @features.ShortHorizonDollarVolumeStatus</small>
                            <small>Session cumulative: @FormatVolume(features.SessionCumulativeVolume)</small>
                        </article>
                        <article class="metric-card">
                            <span>TREND</span>
                            <strong>@features.SessionTrendDirection</strong>
                            <small>VWAP slope: @features.SessionVwapSlopeDirection · EMA fast/medium: @FormatPrice(features.FastEma) / @FormatPrice(features.MediumEma)</small>
                            <small>Price structure: @(features.SessionPriceStructure?.ToString() ?? "Insufficient") · ADX: @FormatPrice(features.SessionAdx) (@features.SessionAdxStatus)</small>
                        </article>
                        <article class="metric-card structure-observations" aria-label="Market Structure">
                            <span>MARKET STRUCTURE</span>
                            <strong>@features.StructureState</strong>
                            <small>Current price: @FormatStructurePrice(features.ReferencePrice) · availability: @features.MarketStructureStatus @(features.HasCompleteSessionData ? "" : "(partial retained state)")</small>
                            <small>Latest swing high: @FormatStructurePrice(features.LatestConfirmedSwingHigh?.Price) · previous: @FormatStructurePrice(features.PreviousConfirmedSwingHigh?.Price) · @features.HighSwingRelationship</small>
                            <small>Latest swing low: @FormatStructurePrice(features.LatestConfirmedSwingLow?.Price) · previous: @FormatStructurePrice(features.PreviousConfirmedSwingLow?.Price) · @features.LowSwingRelationship</small>
                            <small>Nearest resistance candidate: @FormatStructurePrice(features.NearestResistanceCandidate?.Price) · support candidate: @FormatStructurePrice(features.NearestSupportCandidate?.Price)</small>
                            <small>Distance to nearest confirmed high/low: @FormatStructurePrice(features.DistanceToNearestConfirmedSwingHigh) / @FormatStructurePrice(features.DistanceToNearestConfirmedSwingLow) (@FormatPercent(features.DistanceToNearestConfirmedSwingHighPercent) / @FormatPercent(features.DistanceToNearestConfirmedSwingLowPercent))</small>
                        </article>
                        <article class="metric-card">
                            <span>QUALITY / RANGE</span>
                            <strong>@opportunity.QualityScore / 100</strong>
                            <small>Range position: @FormatPercent(features.SessionRangePositionPercent) · realized volatility: @FormatPercent(features.SessionRealizedVolatilityPercent)</small>
                            <small>Data quality: @features.DataQuality · complete session: @features.HasCompleteSessionData</small>
                        </article>
                    </section>

                    <section class="invalidation-panel market-situation-panel" aria-label="Market situation">
                        <h3>MARKET SITUATION</h3>
                        @if (result.MarketSituation is { } situation)
                        {
                            <p>
                                Current: @FormatStructurePrice(situation.CurrentReferencePrice) ·
                                Context: @MarketSituationContextLabel(situation.ContextMode) ·
                                as of @FormatUtc(situation.AsOfUtc)
                            </p>
                            @if (situation.PrimarySituation is { } primary)
                            {
                                var primaryInteraction = primary.Side == MarketSituationSide.Support
                                    ? situation.SupportInteraction
                                    : situation.ResistanceInteraction;
                                <p>
                                    <strong>@MarketSituationLabel(primary.SituationType)</strong>
                                    · nearest active interaction
                                </p>
                                <p>@MarketSituationDescription(primary.SituationType, primaryInteraction!.Level.Source)</p>
                            }
                            else if (situation.Status == MarketSituationStatus.Available)
                            {
                                <p>No structural level is currently within the configured approach or test zone.</p>
                            }
                            else
                            {
                                <p>@situation.UnavailableReason</p>
                            }

                            @if (situation.SupportInteraction is { } support)
                            {
                                <h4>Support · @MarketSituationLabel(support.SituationType)</h4>
                                <p>
                                    @LevelSourceLabel(support.Level.Source): @FormatStructurePrice(support.Level.Price) ·
                                    test zone: @FormatStructurePrice(support.ZoneLow) - @FormatStructurePrice(support.ZoneHigh) ·
                                    distance to zone: @FormatStructurePrice(support.DistanceToActiveZone)
                                    (@FormatPercent(support.DistanceToActiveZonePercent))
                                </p>
                            }
                            @if (situation.ResistanceInteraction is { } resistance)
                            {
                                <h4>Resistance · @MarketSituationLabel(resistance.SituationType)</h4>
                                <p>
                                    @LevelSourceLabel(resistance.Level.Source): @FormatStructurePrice(resistance.Level.Price) ·
                                    test zone: @FormatStructurePrice(resistance.ZoneLow) - @FormatStructurePrice(resistance.ZoneHigh) ·
                                    distance to zone: @FormatStructurePrice(resistance.DistanceToActiveZone)
                                    (@FormatPercent(resistance.DistanceToActiveZonePercent))
                                </p>
                            }

                            <p class="muted">
                                This is a descriptive reference to current price and structural levels, not a trade signal
                                or a prediction that a level will hold, fail, or reverse.
                                @situation.DefinitionVersion · @situation.ConfigurationVersion
                            </p>
                            @if (situation.EligibleLevels.Count > 0)
                            {
                                <details>
                                    <summary>Eligible structural reference levels (@situation.EligibleLevels.Count)</summary>
                                    <ul class="evidence-list">
                                        @foreach (var level in situation.EligibleLevels)
                                        {
                                            <li>
                                                <strong>@LevelSourceLabel(level.Source) · @FormatStructurePrice(level.Price)</strong>
                                                <span>Source session @level.SourceSessionId · @level.SourceCompleteness · @level.HistoricalSource</span>
                                            </li>
                                        }
                                    </ul>
                                </details>
                            }
                        }
                        else
                        {
                            <p>Market situation is not available for this analysis.</p>
                        }
                    </section>

                    <section class="invalidation-panel market-reaction-panel" aria-label="Market reaction">
                        <h3>MARKET REACTION</h3>
                        @if (result.MarketReactions is { Count: > 0 } reactions)
                        {
                            @foreach (var reaction in reactions.OrderByDescending(item => item.Assessment.AsOfUtc))
                            {
                                <article class="reaction-assessment">
                                    <h4>
                                        @ReactionLabel(reaction.Assessment.Reaction) · @reaction.Assessment.Status
                                    </h4>
                                    <p>
                                        Pinned @(reaction.Episode.Role == ImportantPriceLevelRole.Support ? "support" : "resistance") level:
                                        @FormatStructurePrice(reaction.Episode.LevelPrice) ·
                                        episode started <time class="local-time" data-local-time datetime="@ToUtcIso(reaction.Episode.StartedAtUtc)">@FormatUtc(reaction.Episode.StartedAtUtc)</time>
                                        · expires <time class="local-time" data-local-time datetime="@ToUtcIso(reaction.Episode.ExpiresAtUtc)">@FormatUtc(reaction.Episode.ExpiresAtUtc)</time>
                                    </p>
                                    @if (reaction.Assessment.ReactionAtUtc is { } reactionAtUtc)
                                    {
                                        <p>
                                            Confirmed at <time class="local-time" data-local-time datetime="@ToUtcIso(reactionAtUtc)">@FormatUtc(reactionAtUtc)</time>
                                            · price @FormatStructurePrice(reaction.Assessment.ReactionPrice)
                                        </p>
                                    }
                                    @if (reaction.ResearchContext is { } context)
                                    {
                                        <p>
                                            Research context at @FormatUtc(context.AsOfUtc):
                                            momentum @FormatPercent(context.ShortHorizonReturnPercent) /
                                            @FormatPercent(context.SecondaryHorizonReturnPercent) ·
                                            VWAP @FormatPrice(context.SessionVwap) ·
                                            trend @context.SessionTrendDirection ·
                                            setup @context.OpportunityClassification (@context.OpportunityQualityScore / 100) ·
                                            data @context.DataQuality · @context.FeatureSetVersion
                                        </p>
                                    }
                                </article>
                            }
                        }
                        else
                        {
                            <p>No market-reaction episode is available for this symbol and session.</p>
                        }
                        <p class="muted">
                            Reaction classification uses only eligible event-time price observations.
                            Research context is descriptive and is not a confirmation gate, entry instruction, or profitability claim.
                        </p>
                    </section>

                    <section class="invalidation-panel readiness-panel" aria-label="Pre-trade readiness">
                        <h3>PRE-TRADE READINESS</h3>
                        @if (result.Readiness is { } readiness)
                        {
                            var assessment = readiness.Assessment;
                            <p>
                                <strong class="readiness-state @ReadinessClass(assessment.State)">@ReadinessLabel(assessment.State)</strong>
                            </p>
                            <p>@ReadinessDescription(assessment.State)</p>
                            <p>
                                Current: @FormatStructurePrice(assessment.CurrentReferencePrice) ·
                                Entry area: @FormatZone(readiness.Plan?.EntryZone) ·
                                Distance: @FormatStructurePrice(assessment.DistanceToEntry)
                                (@FormatRiskMultiple(assessment.DistanceToEntryRiskMultiple) of risk/share)
                            </p>
                            <p>
                                Invalidation: @FormatStructurePrice(readiness.Plan?.InvalidationPrice) ·
                                Target 1: @FormatStructurePrice(readiness.Plan?.Target1?.Price) ·
                                Reward / Risk: @FormatRewardRisk(readiness.Plan?.RewardRiskRatioTarget1)
                            </p>
                            <p>
                                Context:
                                @(assessment.ContextMode == ReadinessContextMode.PriorSessionEnhanced
                                    ? "Prior Session + Today"
                                    : "Today Only")
                                @if (assessment.ContextMode == ReadinessContextMode.CurrentSessionOnly)
                                {
                                    <span> · prior-session history unavailable or incomplete</span>
                                }
                            </p>
                            <p>
                                Reason: @assessment.Reason ·
                                tracked plan @readiness.Tracked.PlanId.ToString("N")[..12] ·
                                lifecycle: @readiness.Tracked.Status ·
                                as of @FormatUtc(assessment.AsOfUtc) ·
                                version @assessment.ReadinessDefinitionVersion
                            </p>
                            @if (assessment.Evidence.Count > 0)
                            {
                                <h4>Readiness evidence</h4>
                                <ul class="evidence-list">
                                    @foreach (var evidence in assessment.Evidence)
                                    {
                                        <li><strong>@evidence.Code</strong><span>@evidence.Description</span></li>
                                    }
                                </ul>
                            }
                            <p class="muted">
                                Readiness describes market conditions around a tracked candidate opportunity.
                                It is not a trade instruction and does not reflect any position or account.
                            </p>
                        }
                        else
                        {
                            <p><strong>UNAVAILABLE</strong> · No tracked candidate opportunity (NoTrackedOpportunity).</p>
                            <p>We cannot reliably assess this opportunity right now; no eligible candidate plan has been pinned for tracking.</p>
                        }
                    </section>

                    <section class="invalidation-panel trade-plan-panel" aria-label="Trade plan">
                        <h3>TRADE PLAN</h3>
                        <p>
                            <strong>@PlanTitle(result.TradePlan) · @result.TradePlan.Status</strong>
                            · current publication: @result.Publication.State
                        </p>
                        <p>
                            Entry zone: @FormatZone(result.TradePlan.EntryZone) ·
                            entry reference: @FormatStructurePrice(result.TradePlan.EntryReferencePrice)
                        </p>
                        <p>
                            Invalidation: @FormatStructurePrice(result.TradePlan.InvalidationPrice) ·
                            Target 1: @FormatStructurePrice(result.TradePlan.Target1?.Price) ·
                            Target 2: @FormatStructurePrice(result.TradePlan.Target2?.Price)
                        </p>
                        <p>
                            Risk/share: @FormatStructurePrice(result.TradePlan.RiskPerShare) ·
                            Reward/share: @FormatStructurePrice(result.TradePlan.RewardPerShareToTarget1) ·
                            Reward / Risk: @FormatRewardRisk(result.TradePlan.RewardRiskRatioTarget1)
                        </p>
                        <p>
                            As of @FormatUtc(result.TradePlan.AsOfUtc) ·
                            expires @FormatUtc(result.TradePlan.ValidUntilUtc) ·
                            version @result.TradePlan.PlanDefinitionVersion
                        </p>
                        @if (result.TradePlan.Evidence.Count > 0)
                        {
                            <h4>Structural reasoning</h4>
                            <ul class="evidence-list">
                                @foreach (var evidence in result.TradePlan.Evidence)
                                {
                                    <li><strong>@evidence.Code</strong><span>@evidence.Description</span></li>
                                }
                            </ul>
                        }
                        <p class="muted">Candidate geometry only; it is not an instruction to trade.</p>
                    </section>

                    <section class="invalidation-panel prior-session-panel" aria-label="Prior session context">
                        <h3>PRIOR SESSION</h3>
                        @if (result.PriorSessionContext is { } priorView)
                        {
                            var prior = priorView.Context;
                            <p>
                                Prior session: @(prior.PriorSessionId ?? "Unavailable") ·
                                completeness: @prior.Completeness ·
                                structure: @prior.StructureState
                            </p>
                            <p>
                                Prior high: @FormatStructurePrice(prior.PriorSessionHigh) ·
                                prior low: @FormatStructurePrice(prior.PriorSessionLow) ·
                                close: @FormatStructurePrice(prior.PriorSessionClose)
                            </p>
                            @if (prior.Completeness != PriorSessionContextStatus.Available)
                            {
                                <p>
                                    Observed high/low: @FormatStructurePrice(prior.ObservedHigh) /
                                    @FormatStructurePrice(prior.ObservedLow) ·
                                    last observed trade: @FormatStructurePrice(prior.LastObservedTrade)
                                </p>
                            }
                            <p>
                                Swing high: @FormatStructurePrice(prior.LatestConfirmedSwingHigh?.Price)
                                (previous @FormatStructurePrice(prior.PreviousConfirmedSwingHigh?.Price)) ·
                                swing low: @FormatStructurePrice(prior.LatestConfirmedSwingLow?.Price)
                                (previous @FormatStructurePrice(prior.PreviousConfirmedSwingLow?.Price))
                                <span title="A confirmed local price peak or trough based on trade points, not OHLC candles.">
                                    (trade-point pivots)
                                </span>
                            </p>
                            <p>
                                Nearest prior support: @FormatStructurePrice(priorView.NearestSupport?.Price)
                                (@FormatDistance(priorView.DistanceToNearestSupport)) ·
                                nearest prior resistance: @FormatStructurePrice(priorView.NearestResistance?.Price)
                                (@FormatDistance(priorView.DistanceToNearestResistance))
                            </p>
                            <p>
                                Distance from current price @FormatStructurePrice(priorView.CurrentReferencePrice):
                                prior high @FormatDistance(priorView.DistanceToPriorHigh) ·
                                prior low @FormatDistance(priorView.DistanceToPriorLow) ·
                                observed high @FormatDistance(priorView.DistanceToObservedHigh) ·
                                observed low @FormatDistance(priorView.DistanceToObservedLow) ·
                                swing high @FormatDistance(priorView.DistanceToLatestSwingHigh) ·
                                swing low @FormatDistance(priorView.DistanceToLatestSwingLow)
                            </p>
                            <p>
                                Source: @(prior.HistoricalSource ?? "Unavailable") ·
                                feed: @(prior.MarketData is null
                                    ? "Unavailable"
                                    : $"{prior.MarketData.Provider} / {prior.MarketData.Feed} / {prior.MarketData.Coverage}") ·
                                definition: @prior.ContextDefinitionVersion
                            </p>
                            <p class="muted">
                                @prior.CompletenessReason
                                Support and resistance are historical reference areas, not guarantees.
                                @if (prior.CloseSemantics == PriorSessionCloseSemantics.LastEligibleTradeAtOrBeforeSessionEnd)
                                {
                                    <span>Close means the final eligible trade by event time at or before session end; it is not an official exchange close.</span>
                                }
                            </p>
                        }
                        else
                        {
                            <p>Prior context unavailable. No historical source/calendar result is attached.</p>
                        }
                    </section>

                    <div class="evidence-grid">
                        <section>
                            <h3>Supporting evidence</h3>
                            @if (opportunity.SupportingEvidence.Count == 0)
                            {
                                <p class="muted">No supporting evidence qualified.</p>
                            }
                            else
                            {
                                <ul class="evidence-list positive">
                                    @foreach (var evidence in opportunity.SupportingEvidence)
                                    {
                                        <li><strong>@evidence.Code</strong><span>@evidence.Description</span></li>
                                    }
                                </ul>
                            }
                        </section>
                        <section>
                            <h3>Contradictory evidence</h3>
                            @if (opportunity.ContradictoryEvidence.Count == 0)
                            {
                                <p class="muted">No contradictions recorded.</p>
                            }
                            else
                            {
                                <ul class="evidence-list contradictory">
                                    @foreach (var evidence in opportunity.ContradictoryEvidence)
                                    {
                                        <li><strong>@evidence.Code</strong><span>@evidence.Description</span></li>
                                    }
                                </ul>
                            }
                        </section>
                    </div>

                    <section class="invalidation-panel">
                        <h3>Invalidation condition</h3>
                        <p>@opportunity.InvalidationCondition</p>
                    </section>

                    <section class="veto-panel" aria-label="Active vetoes">
                        <h3>Vetoes · @(opportunity.ActiveVetoes.Count == 0 ? "none" : "trade rejected")</h3>
                        @if (opportunity.ActiveVetoes.Count == 0)
                        {
                            <p>No active vetoes.</p>
                        }
                        else
                        {
                            <ul>
                                @foreach (var veto in opportunity.ActiveVetoes)
                                {
                                    <li>@veto</li>
                                }
                            </ul>
                        }
                    </section>

                    <footer class="version-row">
                        <span>Market data: @opportunity.MarketData.Provider / @opportunity.MarketData.Feed (@opportunity.MarketData.Coverage)</span>
                        <span>Opportunity: @opportunity.Id.ToString("N")[..12]</span>
                        <span>Feature set: @opportunity.FeatureSetVersion</span>
                        <span>Setup: @opportunity.SetupDefinitionVersion</span>
                        <span>Configuration: @opportunity.ConfigurationVersion</span>
                    </footer>
                </article>
            }
        </section>
    }

    <p class="disclaimer">Read-only market-data analysis. A setup quality score is descriptive and is not a trading recommendation.</p>
</section>

@code {
    private ScannerStatus _status = new(
        MarketDataHealthStatus.Connecting,
        "Unknown",
        0,
        null,
        null,
        Capabilities: MarketDataCapabilities.Unknown);
    private IReadOnlyList<ScannerAnalysisResult> _results = [];
    private IReadOnlyList<SymbolOverviewTile> _overview = [];
    private IJSObjectReference? _localTimeModule;

    private sealed record SymbolOverviewTile(
        ScannerAnalysisResult Result,
        string DetailAnchor,
        string PrimaryStatus,
        string StatusClass,
        string? SecondaryContext);

    private string FeedClass => _status.FeedStatus switch
    {
        MarketDataHealthStatus.Recorded => "feed-recorded",
        MarketDataHealthStatus.Live => "feed-live",
        MarketDataHealthStatus.Stale or MarketDataHealthStatus.Offline => "feed-stale",
        MarketDataHealthStatus.Error => "feed-error",
        _ => "feed-pending"
    };

    private static string PublicationClass(OpportunityLifecycleState state) => state switch
    {
        OpportunityLifecycleState.Active => "publication-active",
        OpportunityLifecycleState.Expired or OpportunityLifecycleState.Invalidated
            or OpportunityLifecycleState.NotQualified => "publication-inactive",
        _ => "publication-suspended"
    };

    protected override void OnInitialized()
    {
        Scanner.Changed += HandleChanged;
        ReadState();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _localTimeModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/local-time.js");
        }

        if (_localTimeModule is not null)
        {
            await _localTimeModule.InvokeVoidAsync("formatLocalTimes");
        }
    }

    private void HandleChanged()
    {
        _ = InvokeAsync(() =>
        {
            ReadState();
            StateHasChanged();
        });
    }

    private void ReadState()
    {
        var result = Scanner.Read();
        _status = result.Status;
        _results = result.Results;
        _overview = BuildOverview(_results);
    }

    private static IReadOnlyList<SymbolOverviewTile> BuildOverview(
        IReadOnlyList<ScannerAnalysisResult> results) =>
        results
            .OrderBy(item => item.Opportunity.SessionId, StringComparer.Ordinal)
            .ThenBy(item => item.Opportunity.Symbol, StringComparer.Ordinal)
            .GroupBy(item => (item.Opportunity.Symbol, item.Opportunity.SessionId))
            .Select(group => group.First())
            .Select(result =>
            {
                var (status, statusClass) = OverviewPrimaryStatus(result);
                return new SymbolOverviewTile(
                    result,
                    CreateDetailAnchor(result.Opportunity.Symbol, result.Opportunity.SessionId),
                    status,
                    statusClass,
                    OverviewSecondaryContext(result));
            })
            .ToArray();

    private static (string Status, string StatusClass) OverviewPrimaryStatus(ScannerAnalysisResult result)
    {
        if (result.Publication.State == OpportunityLifecycleState.Suspended)
        {
            return ("SUSPENDED", "overview-suspended");
        }

        if (result.Readiness is not { } readiness
            || readiness.Assessment.Reason == PreTradeReadinessReason.NoTrackedOpportunity)
        {
            return ("NO TRACKED CANDIDATE", "overview-muted");
        }

        var state = readiness.Assessment.State;
        var statusClass = state switch
        {
            PreTradeReadinessState.EntryReady => "overview-positive",
            PreTradeReadinessState.EntryZoneActive => "overview-attention",
            PreTradeReadinessState.SetupForming => "overview-caution",
            PreTradeReadinessState.Suspended => "overview-suspended",
            PreTradeReadinessState.Unavailable or PreTradeReadinessState.NoLongerActionable => "overview-muted",
            _ => "overview-neutral"
        };
        return (ReadinessLabel(state), statusClass);
    }

    private static string? OverviewSecondaryContext(ScannerAnalysisResult result)
    {
        var latestReaction = result.MarketReactions?
            .OrderByDescending(item => item.Assessment.AsOfUtc)
            .FirstOrDefault();
        if (latestReaction is not null)
        {
            return latestReaction.Assessment.Status == MarketReactionStatus.Confirmed
                && latestReaction.Assessment.Reaction is { } reaction
                    ? ReactionLabel(reaction)
                    : "Unresolved Reaction";
        }

        return result.MarketSituation?.PrimarySituation is { } primary
            ? MarketSituationLabel(primary.SituationType)
            : null;
    }

    private string? DetailAnchorFor(ScannerAnalysisResult result) =>
        _overview.FirstOrDefault(tile => ReferenceEquals(tile.Result, result))?.DetailAnchor;

    private static string CreateDetailAnchor(string symbol, string sessionId) =>
        $"symbol-{Convert.ToHexString(System.Text.Encoding.UTF8.GetBytes(symbol))}" +
        $"-{Convert.ToHexString(System.Text.Encoding.UTF8.GetBytes(sessionId))}";

    private static string OverviewAccessibleLabel(SymbolOverviewTile tile)
    {
        var context = tile.SecondaryContext is null ? string.Empty : $", {tile.SecondaryContext}";
        return $"{tile.Result.Opportunity.Symbol}, session {tile.Result.Opportunity.SessionId}, " +
            $"{tile.PrimaryStatus}{context}. Jump to detailed analysis.";
    }

    private string FreshnessClass(FeatureSnapshot features) =>
        features.DataQuality != DataQualityStatus.Good
        || !features.IsQuoteValid
        || !features.IsPriceDataValid
        || features.QuoteAge is null
        || features.QuoteAge > TimeSpan.FromSeconds(Configuration.MaximumQuoteAgeSeconds)
            ? "stale-text"
            : "fresh-text";

    private string FreshnessLabel(FeatureSnapshot features) =>
        features.QuoteAge is null
        || features.QuoteAge > TimeSpan.FromSeconds(Configuration.MaximumQuoteAgeSeconds)
            ? "Stale"
            : features.DataQuality == DataQualityStatus.Good
                && features.IsQuoteValid
                && features.IsPriceDataValid
                ? "Fresh"
                : features.DataQuality.ToString();

    private static string ClassificationLabel(OpportunityClassification classification) => classification switch
    {
        OpportunityClassification.ProbableLong => "PROBABLE LONG",
        OpportunityClassification.ProbableShort => "PROBABLE SHORT",
        OpportunityClassification.Watch => "WATCH",
        _ => "AVOID / NO TRADE"
    };

    private static string ClassificationClass(OpportunityClassification classification) => classification switch
    {
        OpportunityClassification.ProbableLong => "long",
        OpportunityClassification.ProbableShort => "short",
        OpportunityClassification.Watch => "watch",
        _ => "avoid"
    };

    private static string PlanTitle(TradePlan plan) => plan.Direction switch
    {
        TradeDirection.Long => "Potential Long Plan",
        TradeDirection.Short => "Potential Short Plan",
        _ => "No Directional Plan"
    };

    private static string ReadinessLabel(PreTradeReadinessState state) => state switch
    {
        PreTradeReadinessState.Unavailable => "UNAVAILABLE",
        PreTradeReadinessState.Suspended => "SUSPENDED",
        PreTradeReadinessState.Watching => "WATCHING",
        PreTradeReadinessState.SetupForming => "SETUP FORMING",
        PreTradeReadinessState.EntryZoneActive => "ENTRY AREA",
        PreTradeReadinessState.EntryReady => "ENTRY READY",
        _ => "NO LONGER ACTIONABLE"
    };

    private static string ReadinessDescription(PreTradeReadinessState state) => state switch
    {
        PreTradeReadinessState.Unavailable => "We cannot reliably assess this opportunity right now.",
        PreTradeReadinessState.Suspended => "The opportunity exists, but current data health is insufficient to treat the assessment as current.",
        PreTradeReadinessState.Watching => "A complete candidate opportunity exists, but price is not yet near the planned entry area.",
        PreTradeReadinessState.SetupForming => "Price is approaching the candidate entry area.",
        PreTradeReadinessState.EntryZoneActive => "Price has reached the candidate entry area, but the full confirmation rule is not currently satisfied.",
        PreTradeReadinessState.EntryReady => "Candidate entry conditions are aligned.",
        _ => "This particular candidate opportunity should no longer be presented as a fresh potential entry."
    };

    private static string ReadinessClass(PreTradeReadinessState state) => state switch
    {
        PreTradeReadinessState.EntryReady => "long",
        PreTradeReadinessState.EntryZoneActive or PreTradeReadinessState.SetupForming => "watch",
        PreTradeReadinessState.NoLongerActionable => "avoid",
        _ => "neutral"
    };

    private static string MarketSituationContextLabel(MarketSituationContextMode contextMode) =>
        contextMode == MarketSituationContextMode.PriorSessionEnhanced
            ? "Prior Session + Today"
            : "Today Only";

    private static string MarketSituationLabel(MarketSituationType situation) => situation switch
    {
        MarketSituationType.ApproachingSupport => "Approaching Support",
        MarketSituationType.TestingSupport => "Testing Support",
        MarketSituationType.CrossedSupport => "Crossed Support",
        MarketSituationType.ApproachingResistance => "Approaching Resistance",
        MarketSituationType.TestingResistance => "Testing Resistance",
        MarketSituationType.CrossedResistance => "Crossed Resistance",
        _ => "Unavailable"
    };

    private static string MarketSituationDescription(
        MarketSituationType situation,
        ImportantPriceLevelSource source)
    {
        var sourceText = source is ImportantPriceLevelSource.PriorSwingHigh
            or ImportantPriceLevelSource.PriorSwingLow
            or ImportantPriceLevelSource.PriorSessionHigh
            or ImportantPriceLevelSource.PriorSessionLow
                ? "an important level from the prior session"
                : "a confirmed structural level from today";
        return situation switch
        {
            MarketSituationType.ApproachingSupport or MarketSituationType.ApproachingResistance =>
                $"Price is moving close to {sourceText}.",
            MarketSituationType.TestingSupport or MarketSituationType.TestingResistance =>
                $"Price is interacting with {sourceText}.",
            MarketSituationType.CrossedSupport or MarketSituationType.CrossedResistance =>
                $"Current price is beyond the test-zone edge of {sourceText}; this alone does not confirm a reaction.",
            _ => "No active level interaction is available."
        };
    }

    private static string ReactionLabel(MarketReactionType? reaction) => reaction switch
    {
        MarketReactionType.SupportHeld => "Support Held",
        MarketReactionType.SupportBreakdown => "Support Breakdown",
        MarketReactionType.SupportReclaimed => "Support Reclaimed",
        MarketReactionType.ResistanceRejected => "Resistance Rejected",
        MarketReactionType.ResistanceBreakout => "Resistance Breakout",
        MarketReactionType.ResistanceFailedBreakout => "Resistance Failed Breakout",
        _ => "Unresolved Reaction"
    };

    private static string LevelSourceLabel(ImportantPriceLevelSource source) => source switch
    {
        ImportantPriceLevelSource.PriorSwingHigh => "Prior swing high",
        ImportantPriceLevelSource.PriorSwingLow => "Prior swing low",
        ImportantPriceLevelSource.PriorSessionHigh => "Prior session high",
        ImportantPriceLevelSource.PriorSessionLow => "Prior session low",
        ImportantPriceLevelSource.CurrentSwingHigh => "Current swing high",
        ImportantPriceLevelSource.CurrentSwingLow => "Current swing low",
        _ => "Structural level"
    };

    private static string FormatRiskMultiple(decimal? multiple) =>
        multiple is null
            ? "--"
            : $"{multiple.Value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}x";

    private static string FormatZone(PriceZone? zone) =>
        zone is null
            ? "--"
            : $"{FormatStructurePrice(zone.Low)} - {FormatStructurePrice(zone.High)}";

    private static string FormatRewardRisk(decimal? ratio) =>
        ratio is null ? "--" : $"{ratio.Value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)} : 1";

    private static string FormatPrice(decimal? price) => price?.ToString("F2") ?? "--";
    private static string FormatStructurePrice(decimal? price) =>
        price is null ? "--" : $"${price.Value:F2}";
    private static string FormatDistance(PriceDistance? distance) =>
        distance is null
            ? "Unavailable"
            : $"{FormatStructurePrice(distance.AbsolutePriceDistance)} ({FormatPercent(distance.PercentDistance)})";
    private static string FormatSwingPrice(decimal price) =>
        price.ToString("G29", System.Globalization.CultureInfo.InvariantCulture);
    private static string FormatPercent(decimal? value) => value is null ? "--" : $"{value.Value:F2}%";
    private static string FormatVolume(long? volume) => volume?.ToString("N0") ?? "--";
    private static string FormatDollars(decimal? value) => value is null ? "--" : $"${value.Value:N0}";
    private static string FormatSpread(decimal? spread) => spread is null ? "—" : $"{spread:F1} bps";
    private static string FormatAge(TimeSpan? age) => age is null ? "Unavailable" : $"{age.Value.TotalSeconds:F1}s";
    private static string? ToUtcIso(DateTimeOffset? value) =>
        value?.ToUniversalTime().ToString("O", System.Globalization.CultureInfo.InvariantCulture);
    private static string FormatUtc(DateTimeOffset? value) => value is null
        ? "--"
        : FormatUtc(value.Value);
    private static string FormatUtc(DateTimeOffset value, string format = "yyyy-MM-dd HH:mm:ss 'UTC'") =>
        value.UtcDateTime.ToString(format, System.Globalization.CultureInfo.InvariantCulture);

    public async ValueTask DisposeAsync()
    {
        Scanner.Changed -= HandleChanged;

        if (_localTimeModule is not null)
        {
            await _localTimeModule.DisposeAsync();
        }
    }
}
